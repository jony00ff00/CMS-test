        ],
        "css": ".cms-details{border:1px solid #d4d4d8;border-radius:6px;padding:.5rem .9rem;margin:1rem 0}\n.cms-details>summary{cursor:pointer;font-weight:600}\n.cms-details[open]>summary{margin-bottom:.5rem}"
      }
