            "type": "text",
            "default": "More about this"
          }
        ],
        "css": ".cms-tip{position:relative;border-bottom:1px dotted currentColor;cursor:help}\n.cms-tip::after{content:attr(data-tip);position:absolute;left:0;bottom:125%;z-index:1;white-space:nowrap;background:#111827;color:#fff;font-size:.8rem;padding:.25rem .5rem;border-radius:4px;opacity:0;pointer-events:none;transition:opacity .15s}\n.cms-tip:hover::after,.cms-tip:focus::after{opacity:1}"
      }
