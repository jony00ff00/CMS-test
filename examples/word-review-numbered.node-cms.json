        "name": "Collapsible details",
        "description": "Hides the content behind a clickable summary",
        "version": 1,
        "mode": "wrap",
        "template": "<details class=\"cms-details\"{{#if params.open}} open{{/if}}>\n  <summary>{{params.summary}}</summary>\n  {{content}}\n</details>",
        "params": [
